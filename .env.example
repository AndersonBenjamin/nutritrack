# Copie para .env (na raiz do projeto, ao lado do docker-compose.yml) e ajuste.
# Gere uma senha forte, por exemplo: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha

# Cookie de sessão só trafega em HTTPS. Use false apenas para testar em http://localhost.
COOKIE_SECURE=true

# Proxies na frente da API: 2 = nginx do container + nginx do host da VPS
TRUST_PROXY=2

# Chave da API da Anthropic (console.anthropic.com) para gerar dietas com IA. Vazia = recurso desligado.
ANTHROPIC_API_KEY=
# Quantas dietas cada usuário pode gerar a cada 24 horas
AI_DIET_DAILY_LIMIT=5
# Só para testes: true devolve um cardápio fake, sem chamar a IA nem precisar de chave
AI_DIET_MOCK=false
