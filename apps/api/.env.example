DATABASE_URL=postgresql://nutrio:nutrio@localhost:5432/nutrio
PORT=3000
# true em produção (HTTPS). Em desenvolvimento via http://localhost pode ficar false.
COOKIE_SECURE=false
# Quantos proxies reversos ficam na frente da API (para identificar o IP real no rate limit)
TRUST_PROXY=1
# Login pelo app-labs (OIDC). Vazias = recurso desligado, login por senha normal.
# As três precisam ser preenchidas juntas, ou nenhuma. O issuer é a URL pública do hub.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
# false desliga o cadastro/login por senha e deixa só o app-labs
AUTH_LOCAL_ENABLED=true
# Chave da API da Anthropic (console.anthropic.com) para gerar dietas com IA. Vazia = recurso desligado.
ANTHROPIC_API_KEY=
# Quantas dietas cada usuário pode gerar por dia
AI_DIET_DAILY_LIMIT=5
# Só para testes: true devolve um cardápio fake, sem chamar a IA nem precisar de chave
AI_DIET_MOCK=false
